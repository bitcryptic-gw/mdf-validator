{
  "name": "mdf-validator",
  "version": "0.1.0",
  "description": "CLI validator for MDF (Markdown First) sites",
  "type": "module",
  "bin": {
    "mdf-validate": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile mdf-validate",
    "build:linux": "bun build src/index.ts --compile --target=bun-linux-x64 --outfile mdf-validate-linux-x64",
    "build:mac": "bun build src/index.ts --compile --target=bun-darwin-arm64 --outfile mdf-validate-mac-arm64",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
